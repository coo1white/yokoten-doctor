---
import Page from "../../layouts/Page.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

export function getStaticPaths() {
  const mods = import.meta.glob("../../data/examples/*.json", { eager: true, import: "default" });
  return Object.entries(mods).map(([p, data]) => {
    const slug = p.split("/").pop()?.replace(".json", "") ?? "";
    return { params: { slug }, props: { data } };
  });
}

const { data } = Astro.props as { data: { result: any; fixes: any; record: any } };
const result = data.result;
const record = data.record;
const date = String(record.recorded_at).slice(0, 10);
const text = JSON.stringify(data).replace(/</g, "\\u003c");
const slug = Astro.params.slug ?? "";
const pageTitle = `${result.owner}/${result.repo}: a saved result \u00b7 yokoten doctor`;
const pageDescription = `A saved yokoten doctor result for ${result.owner}/${result.repo}. It doesn't grade the repo.`;
const pagePath = `/example/${slug}.html`;
---
<Page noindex title={pageTitle} description={pageDescription} path={pagePath}>
<Header />
<main id="main">
<noscript><p class="wide small muted">Showing a saved check needs JavaScript. You can also run it on your machine: npx yokoten</p></noscript>
<div id="app" hidden></div>
</main>
<Footer />
<div id="saved-check" data-check={text} data-saved={date} hidden></div>
<script src="../../client/app.ts"></script>
</Page>
