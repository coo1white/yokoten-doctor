---
interface Example { repo: string; }
const { examples } = Astro.props as { examples: Example[] };
---
<ul>
  {examples.map((ex) => {
    const slug = ex.repo.replaceAll("/", "-");
    return (
      <li><a class="ex" href={`/example/${slug}.html`}><span class="ex-name">{ex.repo}</span><span class="ex-go"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></span></a></li>
    );
  })}
</ul>
