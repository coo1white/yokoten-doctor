---
import Mark from "./Mark.astro";
interface Props {
  isHome?: boolean;
  isAgent?: boolean;
}
const { isHome = false, isAgent = false } = Astro.props as Props;
const SITE_REPO = "https://github.com/coo1white/yokoten-doctor";
---
<header class="site-head"><div class="wide top">
  <a class="skip" href="#main">Skip to content</a>
  <a class="home ctl" href="/" aria-label="yokoten doctor home"><Mark size={26} /><span>yokoten doctor</span></a>
  {isHome ? null : <a class="link ctl top-check" href="/">Check a repo</a>}
  <a class="link link-quiet ctl top-about" href="/about.html">About</a>
  <div class="seg" role="group" aria-label="Page version">{isAgent ? (<><a class="seg-item ctl" href="/">Human</a><span class="seg-item is-on" aria-current="page">Agent</span></>) : (<><span class="seg-item is-on" aria-current="page">Human</span><a class="seg-item ctl" href="/agent-view.html">Agent</a></>)}</div>
  <button type="button" class="icon-btn ctl top-theme" data-theme-next aria-label="Theme"><svg class="t-ic t-sys" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg><svg class="t-ic t-light" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" /></svg><svg class="t-ic t-dark" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg></button>
  <a class="icon-btn ctl top-gh" href={SITE_REPO} aria-label="yokoten doctor on GitHub" title="GitHub"><svg width="20" height="20" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59 .4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23 .82.72 1.21 1.87.87 2.33 .66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2 .82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12 .51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95 .29.25 .54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15 .46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg></a>
</div></header>
