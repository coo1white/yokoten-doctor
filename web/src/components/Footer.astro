---
interface Props {
  isHome?: boolean;
}
const { isHome = false } = Astro.props as Props;
const SITE_REPO = "https://github.com/coo1white/yokoten-doctor";
---
<footer class="foot"><div class="wide foot-in">
  <p class="small muted">A free check for public GitHub repos.</p>
  <nav aria-label="Links"><ul>
    <li><a class="link link-quiet ctl" href="/about.html">About</a></li>
    <li><a class="link link-quiet ctl" href={SITE_REPO}>GitHub</a></li>
    {isHome ? null : <li><a class="link link-quiet ctl" href="/">Check a repo</a></li>}
    <li><a class="link link-quiet ctl" href={`${SITE_REPO}/issues`}>Report a problem</a></li>
  </ul></nav>
</div></footer>
